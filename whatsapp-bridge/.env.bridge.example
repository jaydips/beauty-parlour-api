# whatsapp-bridge/.env.bridge - copy to .env.bridge on the server (chmod 0600). Never commit.
# Shared secret between the PHP app and the bridge: 48+ random characters,
# the same value as `whatsapp.bridgeKey` in the PHP .env.
BRIDGE_KEY=<long random string>
# Loopback port the bridge listens on; `whatsapp.bridgeUrl` in the PHP .env is http://127.0.0.1:<PORT>
PORT=3310
HOST=127.0.0.1
# WhatsApp session files (relative to this folder). Private: whoever has them controls the account.
WA_AUTH_DIR=auth_state
LOG_LEVEL=warn
# Hard cap on messages per minute, on top of the PHP pacing.
WA_MAX_PER_MINUTE=10
