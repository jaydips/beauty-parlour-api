#--------------------------------------------------------------------
# beauty-parlour-api - PRODUCTION .env TEMPLATE (cPanel shared hosting)
#
# Copy this file to /home/<cpanel-user>/beauty-parlour-api/.env on the
# server and replace every <placeholder>. Never commit or download it.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# The public URL of the API, with trailing slash
app.baseURL = 'https://<hostname>/'
app.forceGlobalSecureRequests = true

# SQLite file, absolute path, outside every document root
database.default.database = /home/<cpanel-user>/beauty-parlour-api/writable/database/beauty_parlour.sqlite

# Web migration runner: generate 64 random hex characters, run
#   https://<hostname>/install/migrate?key=<this value>
# then COMMENT THIS LINE OUT again. Without it both /install routes return 404.
install.key = <64 random hex characters>

# Phase 2 (authentication) will need an encryption key:
# encryption.key =
